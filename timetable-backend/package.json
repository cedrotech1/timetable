{
  "name": "ur-timetable-backend",
  "version": "1.0.0",
  "description": "University of Rwanda Timetable System - Backend API",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "babel-node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development nodemon --exec babel-node ./src/index.js",
    "start:uat": "cross-env NODE_ENV=uat nodemon --exec babel-node ./src/index.js",
    "start:prod": "cross-env NODE_ENV=production nodemon --exec babel-node ./src/index.js",
    "start:prod:server": "cross-env NODE_ENV=production babel-node ./src/index.js",
    "start:uat:server": "cross-env NODE_ENV=uat babel-node ./src/index.js",
    "build": "babel src --out-dir dist --source-maps inline --copy-files",
    "db:ensure": "node scripts/ensure-db.js",
    "migrate": "cross-env NODE_ENV=development npx sequelize-cli db:migrate",
    "migrate:uat": "cross-env NODE_ENV=uat npx sequelize-cli db:migrate",
    "migrate:prod": "cross-env NODE_ENV=production npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo:all",
    "seed": "cross-env NODE_ENV=development npx sequelize-cli db:seed:all",
    "seed:uat": "cross-env NODE_ENV=uat npx sequelize-cli db:seed:all",
    "seed:prod": "cross-env NODE_ENV=production npx sequelize-cli db:seed:all",
    "seed:php": "node scripts/import-timetable-sql.js",
    "passwords:set": "node scripts/set-all-passwords.js",
    "db:setup": "npm run db:ensure && npm run migrate && npm run seed",
    "db:reset": "npm run migrate:undo && npm run migrate && npm run seed:php"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^7.14.5",
    "@babel/core": "^7.14.6",
    "@babel/node": "^7.14.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-env": "^7.14.7",
    "@babel/register": "^7.14.5",
    "axios": "^1.7.9",
    "babel-plugin-add-module-exports": "^1.0.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.1",
    "cloudinary": "^1.41.0",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.3",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-async-handler": "^1.2.0",
    "express-fileupload": "^1.4.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "helmet": "^8.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.0",
    "moment": "^2.29.4",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.23.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.7.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^5.22.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^2.0.16",
    "sequelize-cli": "^6.6.2"
  }
}
