# General
PORT=9000
HOST=127.0.0.1
NODE_ENV=development

# CORS — * / all = allow every origin; or comma-separated list
CORS_ORIGINS=*
CORS_ALLOW_ALL=1
CORS_ALLOW_LAN=1

# Rate limiting (requests per 15 minutes per IP)
RATE_LIMIT_AUTH_MAX=25
RATE_LIMIT_API_MAX=600

# Database (local PostgreSQL)
DEV_DATABASE_NAME=ur_timetable
DEV_DATABASE_USER=postgres
DEV_DATABASE_PASSWORD=your_password
DEV_DATABASE_HOST=localhost
DEV_DATABASE_PORT=5432

PRO_DATABASE_NAME=ur_timetable
PRO_DATABASE_USER=postgres
PRO_DATABASE_PASSWORD=your_password
PRO_DATABASE_HOST=localhost
PRO_DATABASE_PORT=5432

UAT_DATABASE_NAME=ur_timetable_uat
UAT_DATABASE_USER=postgres
UAT_DATABASE_PASSWORD=your_password
UAT_DATABASE_HOST=localhost
UAT_DATABASE_PORT=5432

# JWT — minimum 32 random characters
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# SMTP (optional)
SMTP_HOST=services.ur.ac.rw
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false
EMAIL_FROM=timetable@ur.ac.rw

APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
