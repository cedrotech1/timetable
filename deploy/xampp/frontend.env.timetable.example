# Copy values into timetable-frontend/.env.production before building on your PC,
# OR create .env.production with these lines, then:
#   cd timetable-frontend
#   npm run build
# Copy the contents of dist/ into the server's C:/xampp/htdocs/timetable/

VITE_BASE_PATH=/timetable/
VITE_API_BASE_URL=/timetable/api/v1
VITE_API_TIMEOUT=60000
VITE_NODE_ENV=production
