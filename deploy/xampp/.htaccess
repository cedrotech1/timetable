# Place this file inside C:/xampp/htdocs/timetable/ (next to index.html)
# Fallback if Directory rewrite in httpd-timetable.conf is not used.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /timetable/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /timetable/index.html [L]
</IfModule>
