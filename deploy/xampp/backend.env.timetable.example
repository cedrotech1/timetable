# Merge into timetable-backend/.env on the XAMPP server (Node must keep running).
# Do not put this inside Apache htdocs.

PORT=9000
HOST=127.0.0.1
NODE_ENV=production

# Allow browser origin for http://localhost/timetable (Apache :80)
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80,http://127.0.0.1:80
CORS_ALLOW_LAN=1

APP_URL=http://localhost/timetable
FRONTEND_URL=http://localhost/timetable

# Keep your existing DB / JWT / SMTP settings — only add CORS + APP_URL above if missing.
